# ============================================================
# Bot propio de WhatsApp — JMP Concrete and Dispatch LLC
# (prueba: venta de cemento por yarda cúbica)
# Copia este archivo como `.env` en esta misma carpeta:
#   cp .env.example .env
# y llena los valores. NUNCA subas el .env a git.
# En producción (Render/Railway) estas variables se configuran
# en el dashboard del proveedor, no con este archivo.
# ============================================================

# --- WhatsApp Cloud API (Meta) ---
# Token de verificación: lo inventas tú (texto secreto). Meta te lo
# pide cuando configuras el webhook y debe coincidir EXACTO.
META_VERIFY_TOKEN=cambia-este-verify-token

# Token de acceso PERMANENTE (System User) de tu app de Meta.
# Se genera en developers.facebook.com > tu app > WhatsApp > API Setup.
META_ACCESS_TOKEN=

# ID del número de teléfono (Phone Number ID), NO el número en sí.
# Aparece en developers.facebook.com > tu app > WhatsApp > API Setup.
META_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (opcional, informativo).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Secreto de la app (opcional pero recomendado): verifica que los
# webhooks entrantes vengan realmente de Meta (firma X-Hub-Signature-256).
META_APP_SECRET=

# Versión de la Graph API (no la cambies salvo que Meta la deprecie).
META_GRAPH_VERSION=v22.0

# --- Panel (login básico) ---
PANEL_USER=admin
# ¡Cámbiala por una contraseña fuerte!
PANEL_PASS=cambia-esta-contrasena

# --- Motor de seguimiento 24h ---
# Secreto para el cron externo que llama GET /api/cron/followup.
# Genera uno largo y aleatorio.
CRON_SECRET=cambia-este-cron-secret
# Horas de espera antes del seguimiento (pedido del dueño: 24).
FOLLOWUP_DELAY_HOURS=24
# Cuántas veces insiste el bot como máximo antes de pasarlo a un humano.
MAX_FOLLOWUP_ATTEMPTS=2

# --- Comportamiento del bot ---
# Si un ESPECIALISTA respondió hace menos de estos minutos, el bot
# no interrumpe con respuestas automáticas.
AUTOREPLY_HUMAN_PAUSE_MIN=30

# --- Servidor ---
PORT=3000
# Carpeta donde se guarda la base local (db.json). En Render usa un
# disco persistente y apunta aquí (ej. /var/data).
DATA_DIR=./data
